{
  "name": "gym-management",
  "version": "1.0.0",
  "description": "Hệ thống quản lý phòng tập Gym toàn diện, hỗ trợ kiểm soát hội viên, thiết bị và doanh thu. Dự án Phát triển phần mềm theo chuẩn kỹ năng ITSS",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
